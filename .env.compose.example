# Values docker-compose.yml reads. Copy to `.env` for local use; in Coolify these are the env rows.
# Never commit the filled-in version.

POSTGRES_PASSWORD=change-me
DATABASE_APP_PASSWORD=change-me-too
# Encryption at rest for stored CV content (ADR-021). `openssl rand -hex 32` — exactly 64 hex chars.
# Unset means CVs are stored in plaintext; the app announces which at startup and /privacy reports it.
# LOSING THIS KEY LOSES EVERY STORED CV. Back it up somewhere that is not this server.
DATA_ENCRYPTION_KEY=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100
# Coolify only. Tells its proxy which service and port back the domain; locally the app is reached
# through 0.0.0.0:3100 or by adding a ports mapping in an override file.
SERVICE_FQDN_APP_3000=

# The local model. Declining the third-party provider routes here, so this is not optional in
# spirit — without it, "no" degrades to a rule engine.
OLLAMA_MODEL=qwen2.5:3b-instruct

# The third-party provider, used only with explicit consent.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=

# Suspends the *plan* half of the third-party gate: everybody gets MiniMax, signed in or not
# (ADR-030). Consent is NOT suspended — the gate simply starts appearing, because there is now a real
# transfer to agree to.
#
# Production runs with this on. Unset here, the credential above is still loaded but no anonymous
# visitor is entitled to it, so `/api/processing` reports `provider: null`, no consent gate appears,
# and every request quietly uses the local model instead — local behaving unlike production with
# nothing on screen to say so. That is worth knowing before debugging a model you are not using.
#
# ⚠️ On means every ingest, advert read and rewrite spends third-party tokens.
HR_THIRD_PARTY_FOR_ALL=

# ── The waiting screen's narration ────────────────────────────────────────────────────────────────
#
# The model call is the longest part of an upload, and the only signal inside it is the reasoning
# channel: measured against MiniMax, the tool JSON arrives in a single delta at the very end, while
# `thinking` produces ~200 updates spread over the first half of the wait (src/structure/ask.ts).
#
# The reasoning text never leaves the process — `src/structure/reasoning.ts` matches it against a fixed
# table of our own words and emits a section key, because a model reasoning about a CV reasons in
# somebody's employers and dates and `/api/progress` is unauthenticated by design.
#
# On by default, and it is free: measured A/B on 2026-08-17 the gateway's own run-to-run variance was
# several times larger than the channel's cost. Set to `off` if a provider bills reasoning tokens
# painfully; the screen falls back to a stage list with no detail inside the long row.
HR_REASONING=

# Tokens the model may spend reasoning. Default 3072. The measured run stopped on its own at well under
# that, so this bounds the pathological case rather than setting a target.
HR_REASONING_BUDGET=
