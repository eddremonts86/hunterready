#!/usr/bin/env bash
#
# The full quality gate, on every push, on every branch.
#
# `.github/workflows/quality.yml` fires on pull requests and on pushes to `master` and `dev`, so a
# feature branch pushed straight up is guarded by this hook and nothing else. It is also the only
# thing that runs the Docker suite before CI does — the `.doc`, OCR and WASM render paths all live
# behind system binaries that a laptop's `pnpm test` silently skips (ADR-012).
#
# Skip it with `SKIP_CI_LOCAL=1 git push` when you know why. Pushing `master` is the one case where
# that is a bad idea: going green there deploys to production.

set -uo pipefail

branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "${SKIP_CI_LOCAL:-}" = "1" ]; then
  echo "pre-push: SKIP_CI_LOCAL=1 — skipping the quality gate for $branch." >&2
  exit 0
fi

# Nothing to check when the push deletes a ref, moves nothing, or moves a commit the remote already
# has under another name. That last case is not hypothetical: creating `dev` at the same commit as
# `master` arrives here with an all-zero remote sha, because *this ref* is new — and reading that as
# "all new work" queues a full gate over commits that already passed one.
has_commits=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  [ "$local_sha" = "$remote_sha" ] && continue
  if [ -n "$(git branch -r --contains "$local_sha" 2>/dev/null)" ]; then
    echo "pre-push: $(git rev-parse --short "$local_sha") is already on the remote — nothing new to gate." >&2
    continue
  fi
  has_commits=1
done
if [ "$has_commits" -eq 0 ]; then
  exit 0
fi

echo "pre-push: running the full quality gate for '$branch' before pushing."
echo "          ~3 minutes with a warm Docker cache. SKIP_CI_LOCAL=1 git push  bypasses it."
echo

if pnpm ci:local; then
  echo
  echo "pre-push: gate green — pushing $branch."
  exit 0
fi

echo >&2
echo "pre-push: the quality gate failed, so the push is refused." >&2
if [ "$branch" = "master" ]; then
  echo "          master deploys on green. Fix it here, not in production." >&2
fi
exit 1
