{
  "name": "hunterready",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && node scripts/copy-assets.mjs",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "test:measure": "HR_MEASURE_REWRITE=1 vitest run rewrite-quality",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:retention": "node scripts/db/retention.mjs",
    "db:reencrypt": "node scripts/db/reencrypt.mjs",
    "deploy:db": "node scripts/deploy/orchestrate.mjs",
    "test:docker": "docker build --target test -t hunterready:test . && docker run --rm hunterready:test",
    "ci:local": "bash scripts/ci/local-quality.sh",
    "lint": "eslint",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "bundle-fonts": "node scripts/bundle-fonts.mjs",
    "docker:build": "docker build -t hunterready:local .",
    "docker:run": "docker run --rm -p 3100:3000 --env-file .env.docker hunterready:local",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@better-auth/drizzle-adapter": "^1.6.27",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
    "@fontsource/lora": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.1.18",
    "@takumi-rs/helpers": "^2.7.2",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.6.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "nitro": "3.0.260610-beta",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.85.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "takumi-pdf": "^0.6.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@fontsource/archivo-narrow": "^5.3.0",
    "@fontsource/caveat-brush": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "unpdf": "^1.8.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
